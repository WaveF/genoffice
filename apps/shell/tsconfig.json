{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    // resolve the sibling source package by path (worktree-safe: a linked
    // node_modules would otherwise typecheck against another checkout) —
    // same mapping as packages/pdf2docx/tsconfig.json
    "paths": {
      "@nexoffice/docx-engine": ["../../packages/docx-engine/src/index.ts"],
      "@nexoffice/font-metrics": ["../../packages/font-metrics/src/index.ts"],
      "@nexoffice/electron-utils": ["../../packages/electron-utils/src/index.ts"],
      "@nexoffice/capabilities": ["../../packages/nexoffice-capabilities/src/index.ts"],
      "@nexoffice/i18n": ["../../packages/i18n/src/index.ts"],
      "@nexoffice/ui": ["../../packages/ui/src/index.ts"],
      "@nexoffice/pptx-engine": ["../../packages/pptx-engine/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../slides/src/main/env.d.ts",
    "../../packages/pdf2docx/src/bidi-js.d.ts"
  ]
}
